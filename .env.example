# Theo Lens — local dev / test environment.

# Postgres connection used by the API, integration tests, and e2e.
THEOLENS_PG_URI=postgresql://theolens:theolens@localhost:5432/theolens

# Optional: override the host port mapped to Postgres (avoid 5432 conflicts).
THEOLENS_PG_PORT=5432

# Optional: API listen port.
THEOLENS_PORT=4318

# OTLP exporters MUST be configured for HTTP/JSON in M0 (protobuf is M1).
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
