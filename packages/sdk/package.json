{
  "name": "@usetheo/lens-sdk",
  "version": "0.0.0",
  "description": "TS/Node instrumentation SDK for Theo Lens — emit OTLP gen_ai spans in ≤10 lines",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsc -b",
    "generate": "cd ../.. && node_modules/.bin/tsc -b packages/core && node_modules/.bin/tsx packages/sdk/scripts/generate-types.ts",
    "test": "pnpm --dir ../.. exec vitest run -c vitest.contract.config.ts packages/sdk/src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
