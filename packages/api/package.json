{
  "name": "@usetheo/lens-api",
  "version": "0.0.0",
  "description": "OTLP/HTTP JSON trace ingestion API for Theo Lens (Hono)",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "pnpm --dir ../.. exec vitest run -c vitest.contract.config.ts packages/api/src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@hono/node-server": "^1.14.4",
    "@opentelemetry/otlp-transformer": "~0.205.0",
    "@usetheo/lens-core": "workspace:*",
    "hono": "^4.7.18",
    "pg": "^8.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
